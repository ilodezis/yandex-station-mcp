# Copy to .env and fill in. Never commit .env.

# Bearer tokens, 24+ chars: openssl rand -base64 36
# agent: Full tool set (Claude Desktop/Code, Antigravity, etc.)
TOKEN_AGENT=REPLACE_WITH_RANDOM_TOKEN_24_CHARS_PLUS
# brain: Voice brain / restricted profile (everything except unprompted announcements)
TOKEN_BRAIN=

# Claude Web (claude.ai custom connector). All three or none; static tokens above keep working.
#   OAUTH_PASSWORD: password typed on the consent page, 12+ chars
#   OAUTH_TOKEN_SECRET: signs access tokens, 32+ chars (openssl rand -base64 48); rotating it revokes them all
#   OAUTH_CLIENT_SECRET: typed into claude.ai next to the client id, 24+ chars
OAUTH_PASSWORD=
OAUTH_TOKEN_SECRET=
OAUTH_CLIENT_SECRET=
# The public HTTPS origin, so discovery documents never trust request headers.
PUBLIC_URL=https://station.example.com
# Optional: OAUTH_CLIENT_ID (default: station-claude-connector), OAUTH_TOKEN_TTL_DAYS (default: 90).
# OAUTH_CLIENT_ID=station-claude-connector
# OAUTH_TOKEN_TTL_DAYS=90

# Speaker Backend: "ssh" (default) or "luna" (nyakokitsu/luna HTTP API)
STATION_BACKEND=ssh

# Luna Backend (when STATION_BACKEND=luna):
# Base URL of Luna daemon (default derives from STATION_ADDR host at port 8099).
# LUNA_ADDR=http://192.168.1.100:8099

# Speaker SSH connection (when STATION_BACKEND=ssh):
# Obtain host key fingerprint: ssh-keyscan -p 2222 -t ed25519 <STATION_IP> | ssh-keygen -lf -
STATION_ADDR=192.168.1.100:2222
STATION_USER=root
STATION_KEY_FILE=/run/secrets/station_key
STATION_HOST_KEY=SHA256:PLACEHOLDER_FINGERPRINT_FROM_SSH_KEYGEN

# Quiet mode schedule (Moscow time or your local timezone)
QUIET_FROM=23:00
QUIET_TO=08:00
TIMEZONE=Europe/Moscow

# Operational limits
MAX_VOLUME=80
LED_MAX_LEVEL=128
LED_ENABLED=true
VOICE_BUDGET=10
